{
  "name": "@etools-plugin/devtools",
  "version": "1.2.0",
  "description": "Developer tools plugin for ETools - JSON formatter, Base64 encoder/decoder, URL encoder, and more",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "build:ui": "tsup src/index.ts src/ui.tsx --format esm --clean",
    "build:dts": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "dev:ui": "tsup src/index.ts src/ui.tsx --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "echo 'Skipping build during publish'"
  },
  "keywords": [
    "etools-plugin",
    "developer-tools",
    "json-formatter",
    "base64",
    "url-encoder",
    "productivity"
  ],
  "author": "ETools Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/etools-team/devtools-plugin"
  },
  "homepage": "https://github.com/etools-team/devtools-plugin#readme",
  "bugs": {
    "url": "https://github.com/etools-team/devtools-plugin/issues"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.11.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "etools": {
    "id": "devtools",
    "displayName": "Developer Tools",
    "description": "Developer utilities - JSON formatter, Base64, URL encode, hash generator, timestamp converter, UUID",
    "category": "developer",
    "permissions": [
      "write:clipboard"
    ],
    "triggers": [
      "dev:",
      "json:",
      "base64:",
      "url:",
      "unicode:",
      "hex:",
      "hash:",
      "ts:",
      "uuid:",
      "ui:"
    ],
    "icon": "🛠️"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "jsbarcode": "^3.12.3",
    "pinyin-pro": "^3.28.0",
    "prettier": "^3.8.1",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.7.0"
  }
}
